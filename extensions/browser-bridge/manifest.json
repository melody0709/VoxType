{
  "manifest_version": 3,
  "name": "VoxType Browser Bridge",
  "description": "Lets VoxType keep its dictation context in the browser without enabling browser accessibility. Reads the focused input field only while you dictate; password fields are never read.",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "options_page": "connection.html",
  "action": {
    "default_popup": "connection.html",
    "default_title": "Pair VoxType dictation context",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
